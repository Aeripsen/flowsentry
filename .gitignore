.venv/
.venv*/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
# trained model artifact - reproducible via `python -m flowsentry.train`
artifacts/*.joblib
# large raw dataset files a developer may drop into data/ (the committed sample under
# data/sample/*.csv.gz IS tracked and is all the repo needs)
data/*.txt
data/*.zip
data/*.csv
# local config overrides (flowsentry.example.yaml is the committed template)
flowsentry.yaml
# private handoff notes
HANDOFF.md

# Terraform working state. The provider lock file (.terraform.lock.hcl) is
# committed on purpose so every machine installs the same provider build.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
